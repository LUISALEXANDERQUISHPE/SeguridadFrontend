# =============================================================================
#  PLANTILLA .env del FRONTEND. Cópiala como .env y completa los valores vacíos.
#  Este archivo SÍ se sube a GitHub: no pongas valores reales aquí.
#
#  .env del FRONTEND: un solo archivo para LOCAL y PRODUCCIÓN.
#
#  Aquí todas las variables tienen el MISMO valor en local y en producción:
#  al desplegar, copia este archivo al servidor tal cual.
#
#  Estos valores quedan incrustados en el JavaScript que descarga el navegador,
#  es decir, son PÚBLICOS: aquí NUNCA va una llave secreta.
# =============================================================================

# Ruta de la API.
# [LOCAL]       /api -> el servidor de Vite (npm run dev) la reenvía al backend (puerto 5000)
# [PRODUCCIÓN]  /api -> Caddy la reenvía al backend
VITE_API_URL=/api

# Supabase (login con Google). Solo la llave PUBLICABLE.
# [AMBOS] los mismos valores que SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY del backend
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --------------------- Cifrado propio (src/security) -------------------------
# Grupo Diffie-Hellman público (RFC 3526, 2048 bits). Debe ser igual a DH_PRIME_HEX / DH_GENERATOR del backend.
# Aquí NUNCA va la llave maestra: el navegador no toca AES ni Huffman.
# [AMBOS] el mismo valor
VITE_DH_PRIME_
VITE_DH_GENERATOR=2

# ------------------------- Opcionales (solo LOCAL) ----------------------------
# Backend al que npm run dev reenvía /api (por defecto http://localhost:5000). Docker no lo usa.
# VITE_BACKEND_PROXY_TARGET=http://localhost:5000
# URL del WebSocket de colaboración (por defecto se deriva de VITE_API_URL). No hace falta en producción.
# VITE_COLLAB_URL=ws://localhost:5000/api/collab
