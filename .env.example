VITE_API_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# /api lo reenvía el servidor de Vite al backend (ver vite.config.ts); así solo hay que compartir el puerto 5173.
# Opcional: backend destino del proxy (por defecto http://localhost:5000)
# VITE_BACKEND_PROXY_TARGET=http://localhost:5000
# Opcional: URL del WebSocket de colaboración (por defecto se deriva de VITE_API_URL)
# VITE_COLLAB_URL=ws://localhost:5000/api/collab


# --- Cifrado propio (src/security) ---
# Grupo Diffie-Hellman público (RFC 3526, 2048 bits). Debe ser igual a DH_PRIME_HEX / DH_GENERATOR del backend.
# Aquí NUNCA va la llave maestra: el navegador no toca AES ni Huffman.
VITE_DH_PRIME_
VITE_DH_GENERATOR=2
